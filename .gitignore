# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# .env* de arriba también taparía la plantilla; la queremos versionada.
!.env.example

# Imágenes subidas desde el panel: son datos, no código.
/public/uploads/*
!/public/uploads/.gitkeep

# Listados del proveedor: son datos, no código. El PDF llega por mail cada mes
# y el .xlsx es el paso intermedio para importarlo con scripts/importar-lista.mjs.
# Lo que queda versionado es el resultado: los productos en la base.
/imagenes/*.pdf
/lista-precios-*.xlsx

# Catálogos y fotos bajados de los sitios de los proveedores, y el Excel de
# revisión que sale de ahí (scripts/fotos-proveedores.mjs). Son datos que se
# vuelven a bajar cuando hagan falta; lo que queda versionado es el resultado:
# las fotos en Supabase Storage y su dirección en cada producto.
/datos-proveedores/
/fotos-propuestas.xlsx
/imagenes/sitio-wiedmer/
/fotos-sitio-propuestas.xlsx

# Unificación de fotos (scripts/unificar-fotos.mjs y unificar-en-storage.mjs):
# las copias locales para mirar, el Excel de lo que falta y el respaldo de las
# direcciones anteriores de cada producto. Son datos de trabajo, no código.
/imagenes/fotos-unificadas/
/imagenes/fotos-unificadas-storage/
/imagenes/prueba-unificada/
/imagenes/_cmp-pixelado.jpg
/productos-sin-foto.xlsx
/fotos-propuestas.original.xlsx
/fotos-sitio-propuestas.original.xlsx
/respaldos/

# Carga de fotos en lote (scripts/fotos-lote.mjs): las fotos que se van a cargar,
# el Excel que las asigna a cada producto y las copias para revisar antes de subir.
/imagenes/fotos-nuevas/
/imagenes/fotos-lote-previa/
/fotos-lote.xlsx
