# ---------------------------------------------------------------------------
# Variables de entorno de la tienda Wiedmer
#
# Para usarlas en local: copiá este archivo como `.env.local` y completá los
# valores. `.env.local` está ignorado por git, así que no se sube nada.
#
#     cp .env.example .env.local
# ---------------------------------------------------------------------------


# --- Acceso al panel (OBLIGATORIAS para entrar a /admin) --------------------
# Login genérico, el mismo para todos los clientes.
#
# No tienen valor por defecto en el código a propósito: `src/config/site.ts` se
# sube al repositorio, y una contraseña escrita ahí queda pública y en el
# historial de git para siempre. Sin estas variables el catálogo funciona
# igual, pero el login del panel rechaza cualquier intento.
#
# En Vercel: Project Settings → Environment Variables.

ADMIN_USER=
ADMIN_PASSWORD=

# Sal usada para hashear el token de sesión de la cookie. Cualquier cadena
# larga y aleatoria. Si la cambiás, se cierran todas las sesiones abiertas.
# Para generar una: openssl rand -hex 32
SESSION_SECRET=


# --- Supabase (todavía no se usa) ------------------------------------------
# Cuando migremos la capa de datos (`src/lib/data-source.ts`), estas dos
# variables son las que hay que completar. Se sacan del panel de Supabase, en
# Project Settings → API.
#
# NEXT_PUBLIC_ ante el nombre significa que la variable también llega al
# navegador; la anon key está pensada para eso y sus permisos se controlan con
# Row Level Security del lado de Supabase.

# NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de servicio: PERMISOS TOTALES, saltea Row Level Security.
# Va SOLO en el servidor. Nunca le pongas el prefijo NEXT_PUBLIC_ ni la subas
# al repo.
# SUPABASE_SERVICE_ROLE_KEY=
